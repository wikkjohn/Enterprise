{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "modules/**/*.ts",
    "apps/worker/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "apps/web"
  ]
}
