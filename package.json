{
  "name": "enterprise-ai-operating-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enterprise AI Operating Platform \u2014 shared enterprise core + modular applications.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @eaop/web dev",
    "build": "pnpm --filter @eaop/web build",
    "start": "pnpm --filter @eaop/web start",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @eaop/web typecheck",
    "lint": "eslint .",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "db:migrate": "tsx packages/db/scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx packages/db/scripts/reset.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "platform:admin": "tsx scripts/create-platform-admin.ts",
    "verify:ai": "tsx scripts/verify-ai-provider.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "@eaop/db": "workspace:*",
    "@eaop/module-catalog": "workspace:*",
    "@eaop/platform": "workspace:*"
  }
}
