# ── Database ───────────────────────────────────────────────────────────────
# Owner/migration connection (DDL). Used only by db:migrate and db:reset.
DATABASE_ADMIN_URL=postgres://eaop:eaop@localhost:5432/eaop_dev
# Runtime connection. MUST be a NON-superuser role without BYPASSRLS so
# PostgreSQL Row-Level Security enforces tenant isolation.
DATABASE_URL=postgres://eaop_app:eaop_app@localhost:5432/eaop_dev

# ── App ────────────────────────────────────────────────────────────────────
# Required, >= 32 chars. Signs SSO / OAuth state.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=
APP_URL=http://localhost:3000
APP_ENV=development            # development | test | staging | production
LOG_LEVEL=info

# ── Secrets ────────────────────────────────────────────────────────────────
# local | aws | azure | vault | gcp   (only "local" is implemented; see docs/CONNECTORS.md)
SECRETS_PROVIDER=local
# 32-byte base64 key for the LOCAL development secret store (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LOCAL_SECRETS_KEY=

# ── Feature switches ───────────────────────────────────────────────────────
ALLOW_SELF_SERVE_SIGNUP=false          # self-service org signup (dev/demo only)
ALLOW_PRIVATE_NETWORK_EGRESS=false     # let connectors/webhooks reach private IPs (dev / on-prem)
ALLOW_LOCAL_SECRETS_IN_PRODUCTION=false
PLATFORM_NAME="Enterprise AI Operating Platform"

# ── Rate limiting ──────────────────────────────────────────────────────────
# Reserved: the shipped limiter is in-memory (per instance). A Redis-backed
# RateLimiter is an extension point (docs/SECURITY.md); REDIS_URL is not read yet.
# REDIS_URL=

# ── AI providers (optional; providers are disabled until configured) ───────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Email (optional; email channel is disabled until configured) ───────────
EMAIL_WEBHOOK_URL=
